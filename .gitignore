# -----------------------------------------
# Python standard ignores
# -----------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.swp
*.swo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# IDE / editor directories
.vscode/
.idea/

# -----------------------------------------
# DO NOT TRACK ANY USER DATA
# PDFs and literature bags
# -----------------------------------------
# Never commit PDFs
*.pdf

# -----------------------------------------
# Treenode/TopicNode runtime output
# These folders belong to the *user’s* workspace,
# not the repo — the repo contains only code.
# -----------------------------------------
# Any topic-root tree created during runs:
# (e.g., root/, papers/, summaries/, children/, split_prompt.json)
root/
**/root/
**/papers/
**/summaries/
**/children/
**/sampled_summary.json
**/hierarchical_summary.json
**/split_prompt.json
**/final_summary.md

# If users create arbitrary topic roots:
# (We match common names but do not interfere with normal code.)
topic_root/
topics/

# -----------------------------------------
# MacOS Finder junk
# -----------------------------------------
.DS_Store
__MACOSX/

# -----------------------------------------
# dotenv secrets
# -----------------------------------------
.env
.env.*
